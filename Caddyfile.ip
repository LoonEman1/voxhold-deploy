{
	# IP literals are commonly omitted from TLS SNI. Inside Docker the local
	# socket address is the container IP, so select the public IP certificate.
	default_sni {$PUBLIC_HOST}
}

# Caddy persists its ACME state in /data, renews automatically, and retries
# after server outages or temporary network and validation failures.

{$CADDY_SITE_ADDRESS} {
	# Security headers for every response (static assets AND /api/*).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(self), camera=(self), display-capture=(self)"
		-Server
	}

	encode zstd gzip

	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
		# Renew around half-life, leaving several days for retries.
		renewal_window_ratio 0.5
	}

	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy {$EDGE_UPSTREAM}
	}
}
