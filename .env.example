# Complete image references. Tags and digests can be changed independently.
VOXHOLD_BACKEND_IMAGE=ghcr.io/looneman1/voxhold-backend:latest
VOXHOLD_FRONTEND_IMAGE=ghcr.io/looneman1/voxhold-frontend:latest
# Internal port listened to by the selected frontend image.
VOXHOLD_FRONTEND_PORT=8080
# unless-stopped enables containers after a Docker/server restart; use no to
# start the stack only manually.
VOXHOLD_RESTART_POLICY=unless-stopped

# domain: Caddy uses its normal automatic HTTPS flow.
# ip: Caddy requests Let's Encrypt's public short-lived IP certificate and
# renews it automatically.
VOXHOLD_TLS_MODE=domain
VOXHOLD_CADDYFILE=./Caddyfile

# Domain or public IP used by Caddy.
PUBLIC_HOST=voxhold.example.com
# Usually identical to PUBLIC_HOST. Use [2001:db8::1] for a bare IPv6 address.
CADDY_SITE_ADDRESS=voxhold.example.com

# server-only: backend:8080
# fullstack:   frontend:<VOXHOLD_FRONTEND_PORT>
EDGE_UPSTREAM=backend:8080

DATABASE_PATH=/app/data/voxhold.db
MIGRATIONS_PATH=/app/migrations
RESET_DATABASE=false

INSTANCE_NAME=Voxhold
BOOTSTRAP_USERNAME=owner
# Leave empty to generate a password and print it once during bootstrap.
BOOTSTRAP_PASSWORD=

WEBRTC_PUBLIC_IP=203.0.113.10
WEBRTC_UDP_PORT=50000
WEBRTC_MAX_PARTICIPANTS=32
WEBRTC_MAX_AUDIO_BITRATE_KBPS=128
WEBRTC_STREAM_UDP_PORT=50001
WEBRTC_STREAM_MAX_VIEWERS=32
WEBRTC_STREAM_MAX_P2P_VIEWERS=8
WEBRTC_STREAM_MAX_VIDEO_BITRATE_KBPS=16000
WEBRTC_STREAM_MAX_AUDIO_BITRATE_KBPS=320
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=

# The backend is reachable only through Caddy in this deployment.
TRUST_PROXY_HEADERS=true
HTTP_RATE_LIMIT_RPS=25
HTTP_RATE_LIMIT_BURST=50
HTTP_WRITE_RATE_LIMIT_RPS=8
HTTP_WRITE_RATE_LIMIT_BURST=16
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
INVITE_RATE_LIMIT_PER_MINUTE=20
INVITE_RATE_LIMIT_BURST=10
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=20
WS_CONNECT_RATE_PER_MINUTE=10
WS_CONNECT_RATE_BURST=5
WS_EVENT_RATE_PER_SECOND=30
WS_EVENT_RATE_BURST=60
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTIONS_PER_USER=5
RATE_LIMIT_MAX_ENTRIES=20000
