# Complete image references. Tags and digests can be changed independently.
VOXHOLD_BACKEND_IMAGE=ghcr.io/looneman1/voxhold-backend:latest
VOXHOLD_FRONTEND_IMAGE=ghcr.io/looneman1/voxhold-frontend:latest
# Internal port listened to by the selected frontend image.
VOXHOLD_FRONTEND_PORT=8080
# unless-stopped enables containers after a Docker/server restart; use no to
# start the stack only manually.
VOXHOLD_RESTART_POLICY=unless-stopped

# Compose profiles selecting which optional services start with plain
# "docker compose up": "web" adds the frontend, "turn" adds the built-in
# coturn relay. Leave empty for backend-only deployments.
# Valid combinations: web,turn | web | turn | (empty)
COMPOSE_PROFILES=web,turn

# domain: Caddy uses its normal automatic HTTPS flow.
# ip: Caddy requests Let's Encrypt's public short-lived IP certificate and
# renews it automatically.
VOXHOLD_TLS_MODE=domain
VOXHOLD_CADDYFILE=./Caddyfile

# Domain or public IP used by Caddy.
PUBLIC_HOST=voxhold.example.com
# Usually identical to PUBLIC_HOST. Use [2001:db8::1] for a bare IPv6 address.
CADDY_SITE_ADDRESS=voxhold.example.com

# server-only: backend:8080
# fullstack:   frontend:<VOXHOLD_FRONTEND_PORT>
EDGE_UPSTREAM=backend:8080

DATABASE_PATH=/app/data/voxhold.db
MIGRATIONS_PATH=/app/migrations
RESET_DATABASE=false

INSTANCE_NAME=Voxhold
BOOTSTRAP_USERNAME=owner
# Leave empty to generate a password and print it once during bootstrap.
BOOTSTRAP_PASSWORD=

WEBRTC_PUBLIC_IP=203.0.113.10
WEBRTC_UDP_PORT=50000
WEBRTC_MAX_PARTICIPANTS=32
WEBRTC_MAX_AUDIO_BITRATE_KBPS=128
WEBRTC_STREAM_UDP_PORT=50001
WEBRTC_STREAM_MAX_VIEWERS=32
WEBRTC_STREAM_MAX_P2P_VIEWERS=8
WEBRTC_STREAM_MAX_VIDEO_BITRATE_KBPS=16000
WEBRTC_STREAM_MAX_AUDIO_BITRATE_KBPS=320

# --- TURN relay (coturn container, compose profile "turn") ---
# install.sh generates TURN_PASSWORD and fills the WEBRTC_CLIENT_ICE_* values
# below automatically when TURN is enabled. The backend serves them to
# authorized browsers via GET /api/v1/webrtc/config — no frontend rebuild is
# needed when these change. To enable manually:
#   1) set TURN_PASSWORD to a long random string
#   2) set WEBRTC_CLIENT_ICE_SERVERS=turn:<WEBRTC_PUBLIC_IP>:<TURN_LISTEN_PORT>?transport=udp,...
#      (wrap an IPv6 WEBRTC_PUBLIC_IP in brackets in URLs only)
#   3) set WEBRTC_CLIENT_ICE_USERNAME / WEBRTC_CLIENT_ICE_CREDENTIAL
#      to TURN_USERNAME / TURN_PASSWORD
#   4) add "turn" to COMPOSE_PROFILES and run: docker compose up -d
TURN_USERNAME=voxhold
TURN_PASSWORD=
TURN_REALM=voxhold
TURN_LISTEN_PORT=3478
TURN_RELAY_PORT_MIN=49160
TURN_RELAY_PORT_MAX=49559
# TURN_USERNAME is shared by all clients, so user-quota must stay 0; the total
# allocation limit is bounded by the relay range (about one port per
# allocation). Widen the range together with your firewall rules.
TURN_USER_QUOTA=0
TURN_TOTAL_QUOTA=400

# ICE servers handed to browser WebRTC clients by the backend runtime endpoint.
WEBRTC_CLIENT_ICE_SERVERS=
WEBRTC_CLIENT_ICE_USERNAME=
WEBRTC_CLIENT_ICE_CREDENTIAL=
# ICE servers for the backend's own Pion sessions. Leave empty on standard
# public deployments: the backend publishes host candidates directly via
# WEBRTC_PUBLIC_IP and its UDP ports.
WEBRTC_SERVER_ICE_SERVERS=
WEBRTC_SERVER_ICE_USERNAME=
WEBRTC_SERVER_ICE_CREDENTIAL=
# Compatibility aliases for the currently published backend, which still
# reads only these legacy names (update.sh keeps them in sync with
# WEBRTC_CLIENT_ICE_*). Remove after the backend switches to the split
# client/server variables.
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=

# The backend is reachable only through Caddy in this deployment.
TRUST_PROXY_HEADERS=trueHTTP_RATE_LIMIT_RPS=25
HTTP_RATE_LIMIT_BURST=50
HTTP_WRITE_RATE_LIMIT_RPS=8
HTTP_WRITE_RATE_LIMIT_BURST=16
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
INVITE_RATE_LIMIT_PER_MINUTE=20
INVITE_RATE_LIMIT_BURST=10
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=20
WS_CONNECT_RATE_PER_MINUTE=10
WS_CONNECT_RATE_BURST=5
WS_EVENT_RATE_PER_SECOND=30
WS_EVENT_RATE_BURST=60
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTIONS_PER_USER=5
RATE_LIMIT_MAX_ENTRIES=20000

# --- Backups and watchdog (backup.sh / restore.sh / watchdog.sh) ---
# Number of newest archives kept in ./backups.
BACKUP_KEEP_COUNT=7
# Mirror every published archive+checksum into this directory, or run a
# custom command receiving the archive path (rsync/rclone/restic).
BACKUP_OFFSITE_DIR=
# BACKUP_OFFSITE_CMD=rclone copy {} remote:voxhold-backups/
BACKUP_OFFSITE_CMD=
# Watchdog: where to send alerts (e.g. https://ntfy.sh/your-secret-topic),
# minimum free megabytes on the docker data root and maximum backup age.
WATCHDOG_NOTIFY_URL=
BACKUP_DISK_MIN_FREE_MB=1024
BACKUP_MAX_AGE_HOURS=26
